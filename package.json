{
	"name": "agent-robber",
	"version": "0.1.0",
	"private": true,
	"description": "Agent Robber — local daemon, CLI TUI, and glass GUI dashboard",
	"scripts": {
		"daemon": "python server.py",
		"tui": "npm --prefix my-agent run dev",
		"gui": "npm --prefix gui run dev",
		"gui:build": "npm --prefix gui run build",
		"desktop": "npm --prefix gui run tauri:dev",
		"desktop:build": "npm --prefix gui run tauri:build",
		"build": "npm --prefix my-agent run build",
		"typecheck": "npm --prefix my-agent run typecheck",
		"smoke": "npm --prefix my-agent run smoke",
		"verify": "npm --prefix my-agent run verify",
		"precheck": "npm run typecheck",
		"check": "npm run smoke"
	},
	"engines": {
		"node": ">=22"
	}
}
