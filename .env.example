# Bring-your-own-key. Uncomment a line, paste the key, or save from the GUI
# Configuration page. Values are never printed by the TUI, GUI, or /keys.
# The rotator loads this file on startup and prunes providers with empty keys.

# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# OMNIROUTE_API_KEY=
# TOKENROUTER_API_KEY=
# TOKENROUTER_API_KEY_2=

# Optional local model (Ollama / LM Studio / vLLM / llama.cpp GGUF). No API key required.
# OLLAMA_API_BASE=http://127.0.0.1:11434
# LMSTUDIO_API_BASE=http://127.0.0.1:1234
# VLLM_API_BASE=http://127.0.0.1:8000
# LLAMACPP_API_BASE=http://127.0.0.1:8080

# Optional AES-256 vault master (32-byte hex). If unset, OS keyring or a local file is used.
# ROBBER_VAULT_KEY=
