{
	"name": "my-agent",
	"version": "1.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"dev": "tsx source/cli.tsx",
		"dev:watch": "tsx watch source/cli.tsx",
		"prestart": "npm run build",
		"start": "node dist/cli.js",
		"smoke": "tsx test/smoke.tsx",
		"verify": "tsx test/verify-frame.tsx",
		"fonts:mono": "python scripts/build_base_neue_mono.py"
	},
	"files": [
		"dist",
		"assets",
		"typography.css"
	],
	"dependencies": {
		"chalk": "^5.6.2",
		"ink": "^5.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"meow": "^11.0.0",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@types/node": "^20.8.10",
		"@types/react": "^18.2.37",
		"@vdemedes/prettier-config": "^2.0.1",
		"ink-testing-library": "^4.0.0",
		"prettier": "^2.8.7",
		"tsx": "^4.6.2",
		"typescript": "^5.2.2"
	},
	"prettier": "@vdemedes/prettier-config"
}
